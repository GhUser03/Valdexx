{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/exchange", "destination": "/exchange/index.html" },
    { "source": "/exchange/", "destination": "/exchange/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" }
      ]
    }
  ]
}
